# Copy to .env for local dev, or add these in Replit → Secrets.

# Server
PORT=5000
NODE_ENV=development

# Required — Replit Postgres connection string
# In Replit: Tools → Database → Create PostgreSQL → copy "Connection string"
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Stored on each signup. Bump when consent/privacy copy changes.
CONSENT_VERSION=2026-09-21

# Optional — your deployed Replit app URL (for logs/reference)
PUBLIC_SITE_URL=https://your-repl-name.your-username.repl.co

# Optional later — confirmation / newsletter emails
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=adityashrivastav2011@gmail.com
# SMTP_PASS=your-app-password
# NEWSLETTER_FROM_EMAIL=adityashrivastav2011@gmail.com
